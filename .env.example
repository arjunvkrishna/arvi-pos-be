# ARVI POS backend - environment example (copy to .env, never commit .env)

# Control database: the cafe registry + platform admins. Cafe data lives in per-cafe databases that the app
# creates itself on the same server. The role needs CREATEDB and CREATEROLE (or set PG_ADMIN_USER/PASSWORD below).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arvi_control
DB_USER=arvi_user
DB_PASSWORD=change_me

# Master key for the per-cafe database passwords stored in the control DB. Generate ONCE: openssl rand -base64 32
# Back it up separately from the database. Losing it means the stored cafe passwords cannot be decrypted.
TENANT_SECRET_KEY=

# Optional: a dedicated role for CREATE DATABASE / CREATE ROLE (CREATEDB CREATEROLE, not superuser)
# PG_ADMIN_USER=
# PG_ADMIN_PASSWORD=

# Optional: first SaaS owner password (otherwise a random one is printed once in the startup log)
# PLATFORM_ADMIN_INITIAL_PASSWORD=

# Browser origins allowed to call the API from another site (comma separated). Default * = any. In production the UI is
# served through nginx on the same origin, so set this to the UI address(es), e.g. https://pos.example.com
# CORS_ALLOWED_ORIGINS=*

JWT_SECRET=change_me_to_a_long_random_string_of_at_least_64_chars
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# true = load the demo menu into newly created cafes
SEED_DEMO_DATA=false

# Per-cafe connection pools / limits (defaults shown)
# TENANT_POOL_MAX_SIZE=6
# TENANT_DB_CONNECTION_LIMIT=30
# TENANT_MAX_OPEN_POOLS=100
