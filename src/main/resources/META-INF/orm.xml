<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_0.xsd"
                 version="3.0">
    <persistence-unit-metadata>
        <persistence-unit-defaults>
            <entity-listeners>
                <entity-listener class="com.neram.pos.tenancy.TenantIdStamper">
                    <pre-persist method-name="stamp"/>
                </entity-listener>
                <entity-listener class="com.neram.pos.access.OutletScopeListener">
                    <pre-persist method-name="stampAndCheckNew"/>
                    <pre-update method-name="checkUpdated"/>
                    <post-load method-name="checkLoaded"/>
                </entity-listener>
            </entity-listeners>
        </persistence-unit-defaults>
    </persistence-unit-metadata>
</entity-mappings>
